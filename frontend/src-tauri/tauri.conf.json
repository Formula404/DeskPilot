{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskPilot",
  "version": "0.1.0",
  "identifier": "com.deskpilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "floating-ball",
        "title": "DeskPilot",
        "width": 132,
        "height": 132,
        "alwaysOnTop": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": true
      },
      {
        "label": "context-menu",
        "title": "DeskPilot Menu",
        "width": 188,
        "height": 216,
        "alwaysOnTop": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "DeskPilot",
        "width": 430,
        "height": 188,
        "alwaysOnTop": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "DeskPilot 设置",
        "width": 860,
        "height": 600,
        "alwaysOnTop": false,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "visible": false
      },
      {
        "label": "knowledge",
        "title": "DeskPilot 知识库",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "alwaysOnTop": false,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
